{
  "settings": {
    "number_of_shards": 5,
    "number_of_replicas": 1,
    "refresh_interval": "5s",
    "analysis": {
      "analyzer": {
        "turkish_analyzer": {
          "type": "custom",
          "tokenizer": "standard",
          "filter": ["lowercase", "turkish_stop", "turkish_stemmer"]
        },
        "english_analyzer": {
          "type": "custom",
          "tokenizer": "standard",
          "filter": ["lowercase", "english_stop", "english_stemmer"]
        }
      },
      "filter": {
        "turkish_stop": {
          "type": "stop",
          "stopwords": "_turkish_"
        },
        "turkish_stemmer": {
          "type": "stemmer",
          "language": "turkish"
        },
        "english_stop": {
          "type": "stop",
          "stopwords": "_english_"
        },
        "english_stemmer": {
          "type": "stemmer",
          "language": "english"
        }
      }
    }
  },
  "mappings": {
    "properties": {
      "externalId":      { "type": "keyword" },
      "platform":        { "type": "keyword" },
      "authorUsername":   { "type": "keyword" },
      "content": {
        "type": "text",
        "analyzer": "turkish_analyzer",
        "fields": {
          "english": { "type": "text", "analyzer": "english_analyzer" },
          "keyword": { "type": "keyword", "ignore_above": 512 }
        }
      },
      "hashtags":        { "type": "keyword" },
      "mentions":        { "type": "keyword" },
      "language":        { "type": "keyword" },
      "sentimentScore":  { "type": "double" },
      "sentimentLabel":  { "type": "keyword" },
      "likes":           { "type": "integer" },
      "shares":          { "type": "integer" },
      "comments":        { "type": "integer" },
      "views":           { "type": "long" },
      "engagementRate":  { "type": "float" },
      "mediaType":       { "type": "keyword" },
      "isRepost":        { "type": "boolean" },
      "publishedAt":     { "type": "date", "format": "strict_date_optional_time||epoch_millis" },
      "indexedAt":       { "type": "date", "format": "strict_date_optional_time||epoch_millis" }
    }
  }
}
