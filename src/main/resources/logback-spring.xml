<?xml version="1.0" encoding="UTF-8"?>
<!--
    Merkezi Log Yönetimi Yapılandırması
    Görev 5: Logback konfigürasyonu ile yapısal loglama,
    rolling file politikası ve seviye bazlı filtreleme.
-->
<configuration scan="true" scanPeriod="30 seconds">

    <!-- ── Değişkenler ── -->
    <property name="LOG_DIR" value="logs"/>
    <property name="APP_NAME" value="social-media-analysis"/>
    <!-- traceId/spanId: Micrometer Tracing tarafından MDC'ye yazılır -->
    <property name="LOG_PATTERN" value="%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] [traceId=%X{traceId:-},spanId=%X{spanId:-}] %-5level [%logger{36}] - %msg%n"/>
    <property name="JSON_PATTERN" value='{"timestamp":"%d{ISO8601}","level":"%level","logger":"%logger","thread":"%thread","traceId":"%X{traceId:-}","spanId":"%X{spanId:-}","message":"%msg","exception":"%ex{short}"}%n'/>

    <!-- ── Console Appender (Renkli) ── -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} %highlight(%-5level) [%X{traceId:-}] %cyan([%logger{24}]) - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- ── Rolling File Appender (Günlük + dosya başına max 10MB, 30 gün arşiv) ── -->
    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_DIR}/${APP_NAME}.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_DIR}/${APP_NAME}.%d{yyyy-MM-dd}.%i.log</fileNamePattern>
            <maxFileSize>10MB</maxFileSize>
            <maxHistory>30</maxHistory>
            <totalSizeCap>500MB</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
        </encoder>
    </appender>

    <!-- ── JSON File Appender (Elasticsearch'e aktarım için) ── -->
    <appender name="JSON_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_DIR}/${APP_NAME}-json.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>${LOG_DIR}/${APP_NAME}-json.%d{yyyy-MM-dd}.log</fileNamePattern>
            <maxHistory>14</maxHistory>
            <totalSizeCap>300MB</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>${JSON_PATTERN}</pattern>
        </encoder>
    </appender>

    <!-- ── Hata Dosyası (Sadece ERROR seviyesi) ── -->
    <appender name="ERROR_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_DIR}/${APP_NAME}-error.log</file>
        <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
            <level>ERROR</level>
        </filter>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>${LOG_DIR}/${APP_NAME}-error.%d{yyyy-MM-dd}.log</fileNamePattern>
            <maxHistory>60</maxHistory>
        </rollingPolicy>
        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
        </encoder>
    </appender>

    <!-- ── Logger Seviyeleri ── -->
    <!-- Uygulama logları -->
    <logger name="com.eren.social_media_analysis" level="DEBUG"/>
    <logger name="com.eren.social_media_analysis.kafka" level="INFO"/>

    <!-- Kafka logları (çok gürültülü, WARN seviyesinde tut) -->
    <logger name="org.apache.kafka" level="WARN"/>
    <logger name="org.springframework.kafka" level="INFO"/>

    <!-- Spark logları -->
    <logger name="org.apache.spark" level="WARN"/>

    <!-- Elasticsearch logları -->
    <logger name="org.springframework.data.elasticsearch" level="INFO"/>

    <!-- Spring framework -->
    <logger name="org.springframework" level="INFO"/>
    <logger name="org.hibernate" level="WARN"/>

    <!-- ── Root Logger ── -->
    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="FILE"/>
        <appender-ref ref="JSON_FILE"/>
        <appender-ref ref="ERROR_FILE"/>
    </root>

</configuration>
