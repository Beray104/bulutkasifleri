{
  "analysis": {
    "analyzer": {
      "turkish_analyzer": {
        "type": "custom",
        "tokenizer": "standard",
        "filter": ["lowercase", "turkish_stop", "turkish_stemmer"]
      },
      "english_analyzer": {
        "type": "custom",
        "tokenizer": "standard",
        "filter": ["lowercase", "english_stop", "english_stemmer"]
      }
    },
    "filter": {
      "turkish_stop": {
        "type": "stop",
        "stopwords": "_turkish_"
      },
      "turkish_stemmer": {
        "type": "stemmer",
        "language": "turkish"
      },
      "english_stop": {
        "type": "stop",
        "stopwords": "_english_"
      },
      "english_stemmer": {
        "type": "stemmer",
        "language": "english"
      }
    }
  }
}
